/**
 * Manuals bundling for the /admin section.
 *
 * WHY THIS EXISTS: the production runtime's working directory is NOT /app
 * (observed: /code — the platform re-homes the bundle), so reading docs/*.md
 * from disk failed with ENOENT in deployment. The admin router still prefers
 * fresh files from disk (dev + any runtime that keeps docs/), but falls back
 * to this generated module, which esbuild inlines into dist/boot.js — the
 * manuals therefore exist in EVERY runtime by construction.
 *
 * GENERATED FILE — do not edit by hand. Regenerate after changing docs/*.md:
 *   npx tsx scripts/gen-manuals-content.mts
 */
import { readFileSync, writeFileSync } from "node:fs";

// Single registry: id, UI title, source markdown, language tag for the UI chip.
const DOCS = [
  { id: "engine-manual-en", title: "Engine Manual (EN)", file: "docs/ALPHA_ENGINE_MANUAL_EN.md", lang: "en" },
  { id: "engine-manual-ru", title: "Engine Manual (RU)", file: "docs/ALPHA_ENGINE_MANUAL.md", lang: "ru" },
  { id: "llm-context", title: "LLM Context", file: "docs/LLM_CONTEXT.md", lang: "en" },
  { id: "design-value-signals", title: "Design: Value & Signals", file: "docs/DESIGN_VALUE_SIGNALS.md", lang: "en" },
];

const entries = DOCS.map((d) => {
  const content = readFileSync(d.file, "utf8");
  // JSON.stringify escapes backticks/${} safely for embedding in a TS string slot
  return `  ${JSON.stringify(d.id)}: { title: ${JSON.stringify(d.title)}, lang: ${JSON.stringify(d.lang)}, content: ${JSON.stringify(content)} },`;
});

const out = `/**
 * GENERATED by scripts/gen-manuals-content.mts — do not edit by hand.
 * Bundled snapshot of docs/*.md for the /admin manuals tab (fallback when the
 * runtime has no docs/ on disk — see api/routers/admin.ts header).
 */
export interface BundledManual {
  title: string;
  lang: string;
  content: string;
}

export const MANUALS_BUNDLED_AT = ${JSON.stringify(new Date().toISOString())};

export const MANUALS_BUNDLED: Record<string, BundledManual> = {
${entries.join("\n")}
};
`;

writeFileSync("api/services/manuals-content.ts", out);
console.log("manuals-content.ts regenerated:", DOCS.map((d) => d.id).join(", "));
