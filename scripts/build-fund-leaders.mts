/**
 * Builds the leaders table of the fund-flow hall (src/desk/flows/hall/leaders-data.ts) from the reviewed research
 * file research/engine/fund-leaders.json: who led each of the largest 13F filers between Q3 2020 and today, and
 * whether a public source refers to that person as a man or a woman. The figure that stands for a fund follows the
 * leader of the quarter; a firm without a confirmed leader is drawn as a mannequin.
 *
 *   npx tsx scripts/build-fund-leaders.mts                      rebuild the table from the research file
 *   npx tsx scripts/build-fund-leaders.mts --merge <leaders.json> <leaders-verified.json>
 *                                                               rebuild the research file from the two research passes
 */
import { readFileSync, writeFileSync } from "node:fs";
import path from "node:path";

interface Leader { name: string; title: string; from: string; to: string | null; gender: "female" | "male" | null; quote: string | null; source: string | null }
interface Entity { cik: number; entity: string; firm: string; face: string; leaders: Leader[]; note: string | null }

const RESEARCH = path.resolve("research/engine/fund-leaders.json");
const TABLE = path.resolve("src/desk/flows/hall/leaders-data.ts");

/** Dates corrected against the verified sources (the second research pass). */
const CORRECTIONS: Record<string, { from?: string; to?: string | null }> = {
  "Walt Bettinger": { to: "2024-12" },
  "Rick Wurster": { from: "2025-01" },
  "Nigel Wilson": { to: "2023-12" },
  "Antonio Simoes": { from: "2024-01" },
  "Ralph Hamers": { to: "2023-04" },
  "Stephen Bird": { to: "2024-06" },
  "Noel Quinn": { to: "2024-09" },
  "Raymond Chun": { from: "2025-04" },
  "Dan Arnold": { to: "2024-10" },
  "Tetsuo Okubo": { to: "2021-04" },
  "Michael Tipsord": { to: "2024-06" },
  "Jim Fox": { to: "2025-01" },
  "Chris Todd": { from: "2025-01" },
};

if (process.argv[2] === "--merge") {
  const entities = JSON.parse(readFileSync(process.argv[3], "utf8")) as (Omit<Entity, "leaders"> & { leaders: (Omit<Leader, "quote" | "source"> & { sources: string[] })[] })[];
  const verified = new Map((JSON.parse(readFileSync(process.argv[4], "utf8")) as { name: string; gender: Leader["gender"]; quote: string | null; url: string | null }[]).map((row) => [row.name, row]));
  const merged: Entity[] = entities.map((entity) => ({
    ...entity,
    leaders: entity.leaders.map((leader) => {
      const check = verified.get(leader.name);
      return {
        name: leader.name,
        title: leader.title,
        from: CORRECTIONS[leader.name]?.from ?? leader.from,
        to: CORRECTIONS[leader.name] && "to" in CORRECTIONS[leader.name] ? CORRECTIONS[leader.name].to! : leader.to,
        // only a gender a source states is kept
        gender: check?.gender ?? null,
        quote: check?.quote ?? null,
        source: check?.url ?? leader.sources[0] ?? null,
      };
    }),
  }));
  writeFileSync(RESEARCH, `${JSON.stringify({ generatedAt: new Date().toISOString(), method: "Leaders from public sources (company pages, major news outlets, Wikipedia); gender only where a fetched page refers to the person with gendered words, quoted here. Dates are month precision.", entities: merged }, null, 1)}\n`);
  console.log(`[fund-leaders] research file: ${merged.length} filers, ${merged.reduce((sum, entity) => sum + entity.leaders.length, 0)} leader entries · ${RESEARCH}`);
}

/** Filers that reported under an older CIK of the same firm (BlackRock until 2024, Vanguard until 2025). */
const ALIASES: Record<number, number> = { 1364742: 2012383, 102909: 2100119 };

const research = JSON.parse(readFileSync(RESEARCH, "utf8")) as { entities: Entity[] };
for (const [alias, cik] of Object.entries(ALIASES)) {
  const entity = research.entities.find((item) => item.cik === cik);
  if (entity && !research.entities.some((item) => item.cik === Number(alias))) research.entities.push({ ...entity, cik: Number(alias), entity: `${entity.entity} (earlier filer)` });
}
const rows = research.entities.map((entity) => {
  const leaders = entity.leaders
    .filter((leader) => leader.from)
    .sort((a, b) => a.from.localeCompare(b.from))
    .map((leader) => `[${JSON.stringify(leader.name)}, ${JSON.stringify(leader.from)}, ${JSON.stringify(leader.to)}, ${leader.gender === "female" ? '"f"' : leader.gender === "male" ? '"m"' : "null"}]`);
  return `  ${entity.cik}: { firm: ${JSON.stringify(entity.firm)}, leaders: [${leaders.join(", ")}] },`;
});
writeFileSync(
  TABLE,
  `/**
 * Who led the largest 13F filers, quarter by quarter, and whether a public source refers to that person as a man
 * or a woman. Generated by scripts/build-fund-leaders.mts from research/engine/fund-leaders.json (sources and
 * quotes there); do not edit by hand.
 */
export type LeaderRow = [name: string, from: string, to: string | null, gender: "f" | "m" | null];

export const FUND_LEADERS: Record<number, { firm: string; leaders: LeaderRow[] }> = {
${rows.join("\n")}
};
`,
);
console.log(`[fund-leaders] table: ${rows.length} filers · ${TABLE}`);
